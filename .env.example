# ---------------------------------------------------------------------------
# RFS Stress Test — environment variables
# Copy to `.env` for local dev, or paste these as Environment Variables
# in your hosting provider's dashboard (Render / Fly / Railway / etc).
# Never commit .env to git — only this .env.example file is safe to share.
# ---------------------------------------------------------------------------

# Flask
# Random string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET=change-this-in-production

# ---- Admin email notification (Gmail) ----
# Where submission notifications are sent.
ADMIN_EMAIL=you@example.com
# The Gmail account that sends the notification.
SMTP_USER=you@gmail.com
# IMPORTANT: this is a Gmail "App Password", NOT your account password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA).
SMTP_PASSWORD=abcd-efgh-ijkl-mnop
# Defaults — only override if you're using a non-Gmail SMTP service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---- Google Sheets submission log ----
# The Sheet ID — pull from the URL between /d/ and /edit:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GSHEETS_SHEET_ID=1AbCdEf...XYZ
# Optional — name of the tab to append to. Auto-created if missing.
GSHEETS_WORKSHEET=Submissions
# The full JSON blob of your Google service-account credentials, as a single
# line. Generate from Google Cloud Console (IAM → Service Accounts → Keys →
# Add Key → JSON), then share your Google Sheet with the service account's
# email address (in the JSON's "client_email" field) as Editor.
# Paste the entire JSON file's contents on one line, including the curly braces.
GSHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"rfs-bot@your-project.iam.gserviceaccount.com",...}
